rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function belongsTo(ventureId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.venture == ventureId;
    }

    function validVenture(ventureId) {
      return ventureId in ['academy', 'education', 'scorehigh', 'it', 'marketing'];
    }

    function staffRole() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['enterprise_owner', 'operations_manager', 'business_development', 'developer', 'specialist'];
    }

    function operationsManagerOrOwner() {
      return staffRole()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['enterprise_owner', 'operations_manager'];
    }

    function educationManagerOrOwner() {
      return operationsManagerOrOwner()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.venture == 'education'
          || (
            'managedVentures' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            && 'education' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedVentures
          )
        );
    }

    function itStaff() {
      return staffRole()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.venture == 'it'
          || (
            'managedVentures' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            && 'it' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedVentures
          )
        );
    }

    function canReadEnterpriseRecord(record) {
      return operationsManagerOrOwner()
        || (request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business_development'
          && record.accessGroup == 'sales')
        || (request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['developer', 'specialist']
          && record.accessGroup == 'delivery');
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'username', 'email', 'venture', 'role', 'batch', 'createdAt',
          'profileCompleted', 'enrollmentID', 'testsAttempted'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && validVenture(request.resource.data.venture)
        && request.resource.data.role == (request.resource.data.venture == 'it' ? 'candidate' : 'student');
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && validVenture(request.resource.data.venture)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'phone', 'profileCompleted', 'venture'
        ])
        && (
          ('role' in resource.data && request.resource.data.role == resource.data.role)
          || (!('role' in resource.data) && !('role' in request.resource.data))
        )
        && (
          !('venture' in resource.data)
          || request.resource.data.venture == resource.data.venture
        )
        && (
          'venture' in resource.data
          || (resource.data.role == 'student'
            && ((resource.data.batch == 'KTS Academy Student' && request.resource.data.venture == 'academy')
              || (resource.data.batch == 'Banking Aspirant' && request.resource.data.venture == 'scorehigh')))
        );
    }

    function canManageEnquiry(ventureId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return staffRole() && (profile.role == 'enterprise_owner'
        || (profile.role in ['operations_manager', 'business_development']
          && (profile.venture == ventureId
            || ventureId in profile.get('managedVentures', [])
            || (ventureId == 'digital' && (profile.venture == 'marketing'
              || 'marketing' in profile.get('managedVentures', [])))
            || (ventureId == 'enterprise' && profile.role == 'operations_manager'))));
    }

    function validFollowUp() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'notes', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.status in ['new', 'contacted', 'scheduled', 'closed']
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /enquiryRequests/{enquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'interest', 'message', 'venture', 'type',
          'source', 'status', 'consent', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 18
        && (request.resource.data.phone.matches('^[+0-9() -]{8,18}$')
          || request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$'))
        && request.resource.data.interest is string
        && request.resource.data.interest.size() >= 2 && request.resource.data.interest.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.venture in ['academy', 'education', 'scorehigh', 'it', 'marketing', 'digital', 'enterprise']
        && request.resource.data.type in ['demo', 'enrollment', 'general', 'hiring', 'project']
        && request.resource.data.source in ['book_a_demo.html', 'book_a_demo_neet.html', 'register.html', 'kts group.html', 'kts_talent_solution.html', 'kts-digital-solution.html',
          'enroll_now_impulse_jee.html', 'enroll_now_impulse_neet.html',
          'enroll_now_momentum_jee.html', 'enroll_now_momentum_neet.html',
          'enroll_now_power_jee.html', 'enroll_now_power_neet.html',
          'enroll_now_velocity_jee.html', 'enroll_now_velocity_neet.html']
        && request.resource.data.status == 'new'
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null && canManageEnquiry(resource.data.venture);
      allow update: if request.auth != null && canManageEnquiry(resource.data.venture) && validFollowUp();
      allow delete: if false;
    }

    // Shared KTS Enterprise operations records. Academy and Digital Solutions
    // live in this same Firebase project's Firestore database.
    match /enterpriseOperations/{recordId} {
      allow read: if staffRole() && canReadEnterpriseRecord(resource.data);
      allow create: if request.resource.data.organization == 'KTS Enterprise'
        && request.resource.data.venture in ['academy', 'digital']
        && operationsManagerOrOwner()
        || (staffRole()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business_development'
          && request.resource.data.organization == 'KTS Enterprise'
          && request.resource.data.venture == 'digital'
          && request.resource.data.type == 'lead'
          && request.resource.data.accessGroup == 'sales');
      allow update: if request.resource.data.organization == 'KTS Enterprise'
        && operationsManagerOrOwner()
        || (staffRole()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business_development'
          && resource.data.venture == 'digital'
          && resource.data.accessGroup == 'sales'
          && request.resource.data.organization == 'KTS Enterprise'
          && request.resource.data.venture == 'digital'
          && request.resource.data.type == 'lead'
          && request.resource.data.accessGroup == 'sales')
        || (staffRole()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['developer', 'specialist']
          && resource.data.venture == 'digital'
          && resource.data.accessGroup == 'delivery'
          && request.resource.data.organization == 'KTS Enterprise'
          && request.resource.data.venture == 'digital'
          && request.resource.data.type == 'project'
          && request.resource.data.accessGroup == 'delivery');
      allow delete: if operationsManagerOrOwner()
        || (staffRole()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business_development'
          && resource.data.venture == 'digital'
          && resource.data.type == 'lead'
          && resource.data.accessGroup == 'sales');
    }

    // Shared KTS Education Center CRM state. Only Education management and
    // enterprise ownership can read or change these administrative records.
    match /educationCrm/{documentId} {
      allow read: if educationManagerOrOwner();
      allow create, update: if educationManagerOrOwner()
        && request.resource.data.organization == 'KTS Education Center'
        && request.resource.data.venture == 'education';
      allow delete: if false;
    }

    // KTS IT Solutions recruitment CRM. Access remains isolated to staff
    // explicitly assigned to the IT venture.
    match /itCrm/{documentId} {
      allow read: if itStaff();
      allow create, update: if itStaff()
        && request.resource.data.organization == 'KTS IT Solutions'
        && request.resource.data.venture == 'it';
      allow delete: if false;
    }

    match /itEmployerLeads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'company', 'phone', 'email', 'role', 'model', 'details',
          'status', 'source', 'venture', 'createdAt'
        ])
        && request.resource.data.venture == 'it'
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'it-homepage'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.company is string
        && request.resource.data.company.size() >= 2
        && request.resource.data.company.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 18
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.role is string
        && request.resource.data.role.size() >= 2
        && request.resource.data.role.size() <= 120
        && request.resource.data.model is string
        && request.resource.data.model.size() <= 80
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.createdAt is timestamp;
      allow read, update: if itStaff();
      allow delete: if false;
    }

    match /itCandidateProfiles/{userId} {
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && belongsTo('it')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.venture == 'it';
      allow read: if (request.auth != null && request.auth.uid == userId && belongsTo('it'))
        || itStaff();
      allow delete: if false;
    }

    match /tests/{testId} {
      allow read: if belongsTo('scorehigh') && resource.data.published == true;
      allow write: if false;
    }

    match /testAttempts/{attemptId} {
      allow create: if belongsTo('scorehigh') && request.resource.data.userId == request.auth.uid;
      allow read: if belongsTo('scorehigh') && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /paymentRequests/{requestId} {
      allow create: if belongsTo('academy')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.venture == 'academy'
        && request.resource.data.status == 'pending';
      allow read: if belongsTo('academy') && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /courseEntitlements/{entitlementId} {
      allow read: if belongsTo('academy')
        && resource.data.userId == request.auth.uid
        && resource.data.venture == 'academy';
      allow write: if false;
    }

    match /courseProgress/{progressId} {
      allow read: if belongsTo('academy') && resource.data.userId == request.auth.uid;
      allow create: if belongsTo('academy')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.venture == 'academy';
      allow update: if belongsTo('academy')
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.venture == 'academy';
      allow delete: if false;
    }

    match /counseling_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'goal', 'studentClass', 'message',
          'venture', 'status', 'timestamp'
        ])
        && request.resource.data.venture == 'academy'
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 15
        && request.resource.data.goal in ['jee', 'neet', 'foundation']
        && request.resource.data.studentClass in ['9', '10', '11', '12', 'dropper']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.timestamp is timestamp;
      allow read: if request.auth != null && canManageEnquiry('academy');
      allow update: if request.auth != null && canManageEnquiry('academy') && validFollowUp();
      allow delete: if false;
    }
  }
}
